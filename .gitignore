# Ignore temp files
*.tmp
*.log
*.bak
*.swp
*.DS_Store
*.__pycache__
*.pyc

# Ignore Python virtual environments
venv/
.venv/

# Ignore archive files
*.zip
*.tar.gz
*.rar

# Ignore sensitive / runtime files
instance/
backups/
doc_archives/
*.db
*.db.*
secret_key
.env

# Ignore dev/utility files
CLAUDE.md
workspace.code-workspace
index.html
file_mapper.py
recalculate_scores.py
backup_script.py
/favicon.ico
gitback.sh
nrw-gitback.sh
utils/
tests/
migrations/

