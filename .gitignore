app/Readme.txt
app/routes/wifi_switcher.sh
app/templates/home_main.vps.html
app/templates/testdata/testdata_main-old.html

# Ignore one-off migration scripts
migrations/migration_script.py
migrations/versions/add_indexes.sql
migrations/versions/cleanup_01.py

# Ignore other unnecessary files
node_modules/
__pycache__/
.idea/
